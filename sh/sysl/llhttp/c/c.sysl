// llhttp, declared verbatim.
//
// **Nothing here is meant to be called by a program.** Every name and every convention is C's: a
// parser is storage the caller supplies, a failure is a small integer, and a callback is one word
// of code that is handed the parser back and has to find its own way home. The module above turns
// those into sysl and is what an application imports.
//
// **The implementation is vendored**, so there is no `@link` directive and nothing has to be
// installed: `llhttp.c`, `api.c` and `http.c` sit beside this file and sysl compiles them as part
// of the build. `llhttp.c` is generated by llhttp's own build from a TypeScript description of the
// state machine, which is why it is 10,000 lines and why it is never edited here.
//
// **There is no shim.** Every name llhttp exports is a real symbol -- there is no `static inline`
// anywhere in the header, and the constants are `enum`s rather than macros, which a `c const` block
// reads either way. The two struct fields with no accessor function are reached by asking the C
// compiler for their offsets, which is the same mechanism as asking it for a size.

module sh.sysl.llhttp.c

@include("llhttp.h")

// ## The parser
//
// llhttp publishes `llhttp_t`'s layout, but the layer above carries it as opaque words: the fields
// are the state machine's business, and the two a program has any use for have accessors or an
// offset below. `opaque struct` is what stops a `*Parser` being confused for anything else.
//
// **A parser IS relocatable, and is still never moved here.** Nothing in `llhttp_t` points into
// itself -- `settings` points at the settings struct and `data` is the caller's -- so copying one
// would work. It is carried in a `&T` anyway, because the settings it points at have to stay put
// and the callbacks have to find their way back to a sysl value that is still there.
opaque struct Parser

/** `llhttp_settings_t` -- twenty-five function pointers and nothing else.
 *
 * **This one IS declared rather than made opaque**, because the layer above has to write every
 * field and there is no setter for any of them. A struct whose every member is a pointer has a
 * layout there is nothing to get wrong, and `sizeof` is asserted against the C's in `tests.sysl`
 * so that a version of llhttp with a twenty-sixth callback fails a test rather than writing past
 * the end of the storage.
 *
 * The order is `llhttp.h`'s. A callback that is null is not called, so a settings built with
 * `no_data`/`no_event` in a slot costs that event nothing.
 */
struct Settings
    on_message_begin: *extern(*Parser) -> i32

    on_protocol:             *extern(*Parser, *u8, usize) -> i32
    on_url:                  *extern(*Parser, *u8, usize) -> i32
    on_status:               *extern(*Parser, *u8, usize) -> i32
    on_method:               *extern(*Parser, *u8, usize) -> i32
    on_version:              *extern(*Parser, *u8, usize) -> i32
    on_header_field:         *extern(*Parser, *u8, usize) -> i32
    on_header_value:         *extern(*Parser, *u8, usize) -> i32
    on_chunk_extension_name:  *extern(*Parser, *u8, usize) -> i32
    on_chunk_extension_value: *extern(*Parser, *u8, usize) -> i32

    on_headers_complete: *extern(*Parser) -> i32

    on_body: *extern(*Parser, *u8, usize) -> i32

    on_message_complete:              *extern(*Parser) -> i32
    on_protocol_complete:             *extern(*Parser) -> i32
    on_url_complete:                  *extern(*Parser) -> i32
    on_status_complete:               *extern(*Parser) -> i32
    on_method_complete:               *extern(*Parser) -> i32
    on_version_complete:              *extern(*Parser) -> i32
    on_header_field_complete:         *extern(*Parser) -> i32
    on_header_value_complete:         *extern(*Parser) -> i32
    on_chunk_extension_name_complete:  *extern(*Parser) -> i32
    on_chunk_extension_value_complete: *extern(*Parser) -> i32

    on_chunk_header:   *extern(*Parser) -> i32
    on_chunk_complete: *extern(*Parser) -> i32
    on_reset:          *extern(*Parser) -> i32
end Settings

// ## The calls
//
// `llhttp_alloc` and `llhttp_free` are deliberately absent: they `malloc` a parser, and every
// parser here lives in storage the caller already owns.

extern "llhttp_init" init(p: *Parser, ty: u8, settings: *Settings)
extern "llhttp_reset" reset(p: *Parser)
extern "llhttp_settings_init" settings_init(s: *Settings)

extern "llhttp_execute" execute(p: *Parser, data: *u8, len: usize) -> i32
extern "llhttp_finish" finish(p: *Parser) -> i32

extern "llhttp_get_type" get_type(p: *Parser) -> u8
extern "llhttp_get_http_major" get_http_major(p: *Parser) -> u8
extern "llhttp_get_http_minor" get_http_minor(p: *Parser) -> u8
extern "llhttp_get_method" get_method(p: *Parser) -> u8
extern "llhttp_get_status_code" get_status_code(p: *Parser) -> i32
extern "llhttp_get_upgrade" get_upgrade(p: *Parser) -> u8

extern "llhttp_message_needs_eof" message_needs_eof(p: *Parser) -> i32
extern "llhttp_should_keep_alive" should_keep_alive(p: *Parser) -> i32

extern "llhttp_pause" pause(p: *Parser)
extern "llhttp_resume" resume(p: *Parser)
extern "llhttp_resume_after_upgrade" resume_after_upgrade(p: *Parser)

extern "llhttp_get_errno" get_errno(p: *Parser) -> i32
extern "llhttp_get_error_reason" get_error_reason(p: *Parser) -> *u8
extern "llhttp_get_error_pos" get_error_pos(p: *Parser) -> *u8

extern "llhttp_errno_name" errno_name(err: i32) -> *u8
extern "llhttp_method_name" method_name(method: u8) -> *u8
extern "llhttp_status_name" status_name(status: i32) -> *u8

// The lenient switches. Each one turns off a check the standard requires, and each one is a hole
// somebody can drive a request through -- the module above says which, one by one.
extern "llhttp_set_lenient_headers" set_lenient_headers(p: *Parser, on: i32)
extern "llhttp_set_lenient_chunked_length" set_lenient_chunked_length(p: *Parser, on: i32)
extern "llhttp_set_lenient_keep_alive" set_lenient_keep_alive(p: *Parser, on: i32)
extern "llhttp_set_lenient_transfer_encoding" set_lenient_transfer_encoding(p: *Parser, on: i32)
extern "llhttp_set_lenient_version" set_lenient_version(p: *Parser, on: i32)
extern "llhttp_set_lenient_data_after_close" set_lenient_data_after_close(p: *Parser, on: i32)
extern "llhttp_set_lenient_optional_lf_after_cr" set_lenient_optional_lf_after_cr(p: *Parser, on: i32)
extern "llhttp_set_lenient_optional_cr_before_lf" set_lenient_optional_cr_before_lf(p: *Parser, on: i32)
extern "llhttp_set_lenient_optional_crlf_after_chunk" set_lenient_optional_crlf_after_chunk(p: *Parser, on: i32)
extern "llhttp_set_lenient_spaces_after_chunk_size" set_lenient_spaces_after_chunk_size(p: *Parser, on: i32)
extern "llhttp_set_lenient_header_value_relaxed" set_lenient_header_value_relaxed(p: *Parser, on: i32)

// ## What the C compiler is asked
//
// **The sizes come from the header rather than from a reading of the struct**, so a new llhttp
// carrying one more field is accommodated by recompiling rather than by somebody noticing.
//
// `PARSER_WORDS` is words rather than bytes because an array of `u64` is 8-aligned by
// construction, and `llhttp_t`'s first pointer field wants that. `PARSER_ALIGN` is asserted
// against 8 in `tests.sysl`, so a platform that wanted more fails rather than corrupting.

c const
    PARSER_SIZE:  usize = "sizeof(llhttp_t)"
    PARSER_ALIGN: usize = "_Alignof(llhttp_t)"
    PARSER_WORDS: usize = "(sizeof(llhttp_t) + 7) / 8"

    SETTINGS_SIZE: usize = "sizeof(llhttp_settings_t)"

// The two fields with no accessor. `content_length` is what `on_chunk_header` reports the chunk
// size in, and `data` is the caller's word -- which the layer above does not use, since it finds
// its way home from the parser's own address instead.
c const
    CONTENT_LENGTH_OFFSET: usize = "offsetof(llhttp_t, content_length)"
    FLAGS_OFFSET:          usize = "offsetof(llhttp_t, flags)"

// `llhttp_type_t`.
c const
    TYPE_BOTH:     u8 = "HTTP_BOTH"
    TYPE_REQUEST:  u8 = "HTTP_REQUEST"
    TYPE_RESPONSE: u8 = "HTTP_RESPONSE"

// `llhttp_errno_t`. Only the ones a caller can act on differently are named; the rest arrive as a
// number with `errno_name` beside it.
c const
    OK:                        i32 = "HPE_OK"
    PAUSED:                    i32 = "HPE_PAUSED"
    PAUSED_UPGRADE:            i32 = "HPE_PAUSED_UPGRADE"
    PAUSED_H2_UPGRADE:         i32 = "HPE_PAUSED_H2_UPGRADE"
    USER:                      i32 = "HPE_USER"
    INVALID_METHOD:            i32 = "HPE_INVALID_METHOD"
    INVALID_URL:               i32 = "HPE_INVALID_URL"
    INVALID_VERSION:           i32 = "HPE_INVALID_VERSION"
    INVALID_HEADER_TOKEN:      i32 = "HPE_INVALID_HEADER_TOKEN"
    INVALID_CONTENT_LENGTH:    i32 = "HPE_INVALID_CONTENT_LENGTH"
    INVALID_CHUNK_SIZE:        i32 = "HPE_INVALID_CHUNK_SIZE"
    INVALID_STATUS:            i32 = "HPE_INVALID_STATUS"
    INVALID_TRANSFER_ENCODING: i32 = "HPE_INVALID_TRANSFER_ENCODING"
    UNEXPECTED_CONTENT_LENGTH: i32 = "HPE_UNEXPECTED_CONTENT_LENGTH"
    CLOSED_CONNECTION:         i32 = "HPE_CLOSED_CONNECTION"
    STRICT:                    i32 = "HPE_STRICT"
    CR_EXPECTED:               i32 = "HPE_CR_EXPECTED"
    LF_EXPECTED:               i32 = "HPE_LF_EXPECTED"
    UNEXPECTED_SPACE:          i32 = "HPE_UNEXPECTED_SPACE"
