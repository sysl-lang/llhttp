module sh.sysl.llhttp
@tests

// The accumulating tier: whole requests, and the two limits that stop one being unbounded.

import sysl.buf.{Buf, buf}

// Somewhere for a callback to put what it was handed, since a test cannot assert from inside one.
private struct Caught
    seen: Buf[string]
    last_body: string
    last_host: string
    keep: bool
    headers: usize
    cookies: Buf[string]

    take(*self, r: &Request)
        self.seen.push(r.method + " " + r.target)
        self.last_body = r.text()
        self.last_host = r.header("host").unwrap_or("-")
        self.keep = r.keep_alive
        self.headers = r.headers.len()
end Caught

private caught() -> &Caught = Caught(buf(), "", "", false, 0, buf())

private first(c: &Caught) -> string = if c.seen.is_empty() then "" else c.seen.at(0)

@test("a whole request reaches the callback with its parts assembled")
a_whole_request()
    val c = caught()
    val r = requests((req) -> c.take(req))

    r.feed("POST /items?page=2 HTTP/1.1\r\nHost: example.com\r\nContent-Length: 8\r\n\r\nhi there"
        .bytes).expect("fed")

    assert_eq(first(c), "POST /items?page=2")
    assert_eq(c.last_body, "hi there")
    assert_eq(c.last_host, "example.com")
    assert_eq(c.headers, 2)

// **The case a hand-written accumulator gets wrong.** llhttp reports a header value as however many
// spans the bytes were split into, so a value straddling two reads arrives in two pieces -- and a
// reader that treated each span as a whole value would deliver `example` and `.com` as two headers.
@test("a request split across reads assembles into the same request")
a_request_split_across_reads()
    val c = caught()
    val r = requests((req) -> c.take(req))
    val text = "GET /x HTTP/1.1\r\nHost: example.com\r\nAccept: text/plain\r\n\r\n".bytes

    for i in 0..<text.len
        r.feed(text[i..<i + 1]).expect("fed a byte")

    assert_eq(first(c), "GET /x")
    assert_eq(c.last_host, "example.com")
    assert_eq(c.headers, 2)

@test("a header is found without regard to case, and a repeated one is kept")
headers_match_without_case()
    val c = caught()

    // The collection has to live in the box the closure captured, not in a `var` beside it: a
    // closure captures by value, so a `Buf` named out here would be a copy the test never sees
    // written to.
    val r = requests((req) ->
        c.take(req)

        val all = req.header_all("SET-COOKIE")

        for i in 0..<all.len() do c.cookies.push(all.at(i)))

    r.feed(("GET / HTTP/1.1\r\nHOST: e.com\r\nSet-Cookie: a=1\r\nset-cookie: b=2\r\n\r\n")
        .bytes).expect("fed")

    assert_eq(c.last_host, "e.com", "a lowercase lookup found an uppercase header")
    assert_eq(c.cookies.len(), 2, "both cookies were kept")
    assert_eq(c.cookies.at(0), "a=1")
    assert_eq(c.cookies.at(1), "b=2")

@test("two pipelined requests are two calls")
two_requests_on_one_connection()
    val c = caught()
    val r = requests((req) -> c.take(req))

    r.feed(("GET /one HTTP/1.1\r\nHost: e.com\r\n\r\n" +
            "GET /two HTTP/1.1\r\nHost: e.com\r\n\r\n").bytes).expect("fed")

    assert_eq(c.seen.len(), 2)
    assert_eq(c.seen.at(0), "GET /one")
    assert_eq(c.seen.at(1), "GET /two")

@test("a chunked body is assembled, and its trailers are headers")
a_chunked_request_with_trailers()
    val c = caught()
    val r = requests((req) -> c.take(req))

    r.feed(("POST /up HTTP/1.1\r\nHost: e.com\r\nTransfer-Encoding: chunked\r\n\r\n" +
            "4\r\nfour\r\n5\r\n five\r\n0\r\nX-Sum: 9\r\n\r\n").bytes).expect("fed")

    assert_eq(c.last_body, "four five")
    assert_eq(c.headers, 3, "the trailer is a header like any other")

@test("Connection: close is reported on the request the callback is handed")
keep_alive_is_read_where_it_is_settled()
    val c = caught()
    val r = requests((req) -> c.take(req))

    r.feed("GET / HTTP/1.1\r\nConnection: close\r\n\r\n".bytes).expect("fed")

    assert(!c.keep, "the client asked for the connection to end")

// -- The limits ------------------------------------------------------------------------------------

// **This is why the tier has limits at all.** Without one, a client that sends
// `Content-Length: 4294967296` and then keeps writing owns the machine -- and it does not even have
// to be malicious, since a file upload to a JSON endpoint looks exactly the same.
@test("a body over the limit is refused, and the refusal says which limit")
a_body_over_the_limit_is_refused()
    val c = caught()
    val r = requests((req) -> c.take(req), Limits(8192, 8))

    val e = r.feed("POST / HTTP/1.1\r\nContent-Length: 20\r\n\r\n01234567890123456789".bytes)
        .expect_err("refused")

    e match
        BodyTooLarge(n) -> assert_eq(n, 8)
        _ -> assert(false, "it should have been the body limit")

    assert(c.seen.is_empty(), "and no request was delivered")

@test("headers over the limit are refused before the body is reached")
a_head_over_the_limit_is_refused()
    val c = caught()
    val r = requests((req) -> c.take(req), Limits(32, 1048576))

    val e = r.feed(("GET /a-fairly-long-target-that-is-charged-too HTTP/1.1\r\n" +
                    "Host: example.com\r\n\r\n").bytes).expect_err("refused")

    e match
        HeadTooLarge(n) -> assert_eq(n, 32)
        _ -> assert(false, "it should have been the head limit")

@test("a malformed request is a Malformed refusal carrying llhttp's fault")
a_malformed_request_is_reported_as_one()
    val c = caught()
    val r = requests((req) -> c.take(req))

    val e = r.feed("POST / HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\nx".bytes)
        .expect_err("refused")

    e match
        Malformed(f) -> assert(f.suspicious(), "two lengths that disagree is worth a log line")
        _ -> assert(false, "it should have been a parse failure")

@test("a request with no body still arrives, with an empty one")
a_request_with_no_body()
    val c = caught()
    val r = requests((req) -> c.take(req))

    r.feed("DELETE /items/7 HTTP/1.1\r\nHost: e.com\r\n\r\n".bytes).expect("fed")

    assert_eq(first(c), "DELETE /items/7")
    assert_eq(c.last_body, "")

// -- A reader does not outlive its owner ---------------------------------------------------------

// Counts how many of its kind have been destroyed, so a test can see a reader's callback released
// when the reader is, rather than kept alive by a cycle through the parser.
private struct Tally
    gone: int
    heads: int

private struct Probe
    tally: &Tally

impl Drop for Probe
    drop(self) = self.tally.gone += 1

@test("a dropped requests reader releases its callback")
a_dropped_reader_is_freed()
    val t: &Tally = Tally(0, 0)
    val seen = caught()

    for i in 0..<3
        val probe: &Probe = Probe(t)
        val r = requests((req) ->
            probe.tally.gone += 0
            seen.take(req))

        r.feed("GET /a HTTP/1.1\r\nHost: x\r\n\r\n".bytes).expect("parsed")

    assert_eq(seen.seen.len(), 3, "each reader delivered its request")
    assert_eq(t.gone, 3, "and each was released when it went out of scope")

@test("a dropped stream reader releases its callback")
a_dropped_stream_is_freed()
    val t: &Tally = Tally(0, 0)

    for i in 0..<3
        val probe: &Probe = Probe(t)
        val s = stream((part) ->
            probe.tally.gone += 0
            part match
                Headers(h) -> probe.tally.heads += 1
                _ -> ())

        s.feed("GET /a HTTP/1.1\r\nHost: x\r\n\r\n".bytes).expect("parsed")

    assert_eq(t.heads, 3, "each reader delivered its head")
    assert_eq(t.gone, 3, "and each was released when it went out of scope")

@test("a dropped parser releases its callback")
a_dropped_parser_is_freed()
    val t: &Tally = Tally(0, 0)

    for i in 0..<3
        val probe: &Probe = Probe(t)
        val p = request_parser((e) -> probe.tally.gone += 0)

        p.execute("GET / HTTP/1.1\r\n\r\n".bytes).expect("parsed")

    assert_eq(t.gone, 3, "each parser was released when it went out of scope")

// -- Whether a head is in progress -----------------------------------------------------------------

@test("heading is false before any byte has arrived")
heading_is_false_initially()
    val r = requests((req) -> ())

    assert(!r.heading(), "no request has started")

@test("heading is true after a partial request line")
heading_is_true_in_a_partial_request_line()
    val r = requests((req) -> ())

    r.feed("GET /par".bytes).expect("fed")

    assert(r.heading(), "a request has begun and its head is not complete")

@test("heading stays true while the headers dribble in one byte at a time")
heading_is_true_while_headers_dribble()
    val r = requests((req) -> ())
    val text = "GET /x HTTP/1.1\r\nHost: example.com\r\nAccept: text/plain\r\n".bytes

    for i in 0..<text.len
        r.feed(text[i..<i + 1]).expect("fed a byte")
        assert(r.heading(), "still in the head after byte " + str(i))

@test("heading is false once the blank line ends the head, before the body arrives")
heading_is_false_after_the_head()
    val c = caught()
    val r = requests((req) -> c.take(req))

    r.feed("POST / HTTP/1.1\r\nContent-Length: 8\r\n\r\nhi".bytes).expect("fed")

    assert(!r.heading(), "the head is complete although the body is not")
    assert(c.seen.is_empty(), "and the request has not been delivered")

@test("heading is false after the full request")
heading_is_false_after_the_request()
    val c = caught()
    val r = requests((req) -> c.take(req))

    r.feed("POST / HTTP/1.1\r\nContent-Length: 2\r\n\r\nhi".bytes).expect("fed")

    assert_eq(c.seen.len(), 1)
    assert(!r.heading(), "between requests no head is in progress")

@test("heading is true again for a pipelined second request's partial head")
heading_is_true_again_for_the_next_request()
    val c = caught()
    val r = requests((req) -> c.take(req))

    r.feed("GET /a HTTP/1.1\r\nHost: x\r\n\r\nGET /b HTT".bytes).expect("fed")

    assert_eq(c.seen.len(), 1)
    assert(r.heading(), "the second request's head has begun")

    r.feed("P/1.1\r\nHost: x\r\n\r\n".bytes).expect("fed")

    assert_eq(c.seen.len(), 2)
    assert(!r.heading(), "and ended")

@test("heading is false after a malformed request")
heading_is_false_after_an_error()
    val r = requests((req) -> ())

    r.feed("POST / HTTP/1.1\r\nContent-Length: 1\r\n".bytes).expect("fed")
    assert(r.heading(), "in the head until the error")

    r.feed("Content-Length: 2\r\n\r\nx".bytes).expect_err("refused")

    assert(!r.heading(), "an errored reader has no head in progress")

@test("heading is false after a head over the limit is refused")
heading_is_false_after_a_refusal()
    val r = requests((req) -> (), Limits(8, 1048576))

    r.feed("GET /a-long-target-over-the-limit HTTP/1.1\r\n\r\n".bytes).expect_err("refused")

    assert(!r.heading(), "a refused reader has no head in progress")
